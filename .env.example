# Never commit .env or a real API key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
