# Copy this file to .env and fill in your values.
# Leave NEBIUS_API_KEY empty to run in offline mode (static rules + rule-based fixes only).

NEBIUS_API_KEY=
# OpenAI-compatible endpoint for Nebius AI Studio / Token Factory. Check your Nebius console
# for the exact base URL of your project if requests fail with 404.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Primary NVIDIA model, then fallbacks tried in order when a model is unavailable.
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FALLBACK_MODELS=nvidia/Nemotron-3-Ultra-550b-a55b

NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_RETRIES=3
AGENTX_MAX_CONCURRENCY=4

# Only needed for `--pr` (push a branch and open a GitHub pull request).
GITHUB_TOKEN=
